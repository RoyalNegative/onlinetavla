# Port the game server listens on (default 8787).
PORT=8787

# Optional — Firebase Admin credentials so the server can verify logins and
# write authoritative stats/leaderboard/history. Without these, accounts are
# disabled and anonymous play still works.
#
# Easiest: paste the whole service-account JSON on one line:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...", ...}
#
# Or point to a service-account file via the standard Google variable:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json
