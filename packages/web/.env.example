# Optional — Firebase web config for account login (Google sign-in).
# Without these, the game works fully; the login button just stays hidden.
# Get these from Firebase Console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — analytics & ad conversion tracking. All off unless set (no-op).
# GA4 measurement id (Google Analytics → Admin → Data streams). Tracks page views
# plus `room_created` / `match_search` events; mark those as conversions and import
# into Google Ads. Set VITE_ADS_CONVERSION_ID instead/also for a dedicated Ads tag.
VITE_GA_MEASUREMENT_ID=
VITE_ADS_CONVERSION_ID=
